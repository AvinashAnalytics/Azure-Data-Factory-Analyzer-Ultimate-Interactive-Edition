### **2. Sequence Diagrams** - Interactions Over Time

**📌 Best For:** API calls, method flows, component communication

```mermaid
%%{init: {'theme':'base'}}%%
sequenceDiagram
    autonumber
    actor User
    participant CLI as CLI Interface
    participant Core as Analyzer Core
    participant Parser as Resource Parser
    participant SQL as SQL Parser
    participant Excel as Excel Exporter
    participant FS as File System
    
    User->>CLI: python analyzer.py template.json
    activate CLI
    CLI->>CLI: Validate arguments
    CLI->>Core: __init__(json_path)
    activate Core
    
    Core->>FS: Load template.json
    activate FS
    FS-->>Core: template_data (dict)
    deactivate FS
    
    Core->>Parser: parse_all_resources()
    activate Parser
    
    loop For each resource type
        Parser->>Parser: parse_pipelines()
        Parser->>Parser: parse_datasets()
        Parser->>Parser: parse_linked_services()
        
        alt Contains SQL
            Parser->>SQL: parse_sql(query)
            activate SQL
            SQL-->>Parser: (source_tables, target_tables)
            deactivate SQL
        end
    end
    
    Parser-->>Core: parsed_resources
    deactivate Parser
    
    Core->>Core: analyze_dependencies()
    Core->>Core: detect_circular_dependencies()
    Core->>Core: calculate_impact()
    
    Core->>Excel: export_to_excel(results)
    activate Excel
    Excel->>FS: Write adf_analysis_latest.xlsx
    FS-->>Excel: Success
    Excel-->>Core: Excel path
    deactivate Excel
    
    Core-->>CLI: Analysis complete
    deactivate Core
    CLI-->>User: ✅ Success: 30 sheets generated
    deactivate CLI
    
    Note over User,FS: Total Time: ~60s for 500 pipelines
```

---

### **3. Class Diagrams** - Architecture & Relationships

**📌 Best For:** Object models, inheritance, composition

```mermaid
%%{init: {'theme':'base'}}%%
classDiagram
    class UltimateEnterpriseADFAnalyzer {
        <<Main Engine>>
        +str json_path
        +dict data
        +dict resources
        +dict results
        +Logger logger
        +Config config
        +run() bool
        +load_template() bool
        +parse_all_resources() void
        +analyze_dependencies() void
        +detect_circular_dependencies() list
        +calculate_impact_analysis() dict
        +export_to_excel() str
        -_validate_template() bool
        -_register_resources() void
    }
    
    class Logger {
        <<Logging System>>
        +int level
        +list errors
        +list warnings
        +list info
        +error(msg: str) void
        +warning(msg: str) void
        +info(msg: str) void
        +debug(msg: str) void
        +get_summary() dict
    }
    
    class Config {
        <<Configuration>>
        +int max_depth
        +int max_impact_levels
        +bool enable_sql_parsing
        +bool apply_patches
        +dict thresholds
        +load_from_file(path) void
        +get(key, default) any
    }
    
    class ResourceParser {
        <<Abstract>>
        +parse_resource(data) dict*
        +validate(data) bool*
        +extract_dependencies(data) list*
    }
    
    class PipelineParser {
        +parse_resource(data) dict
        +parse_activities(activities, depth) list
        -_parse_copy_activity(activity) dict
        -_parse_dataflow_activity(activity) dict
        -_parse_control_activity(activity) dict
    }
    
    class DatasetParser {
        +parse_resource(data) dict
        +extract_schema_info(data) dict
        +get_linked_service_ref(data) str
    }
    
    class SQLParser {
        <<Static Utility>>
        +parse_sql(sql: str) tuple~set, set~
        +extract_tables(sql: str) set
        +extract_columns(sql: str) set
        -_handle_ctes(sql: str) str
        -_balance_parentheses(sql: str) bool
    }
    
    class TextSanitizer {
        <<Static Utility>>
        +sanitize_value(value: any) str
        +sanitize_sheet_name(name: str) str
        +truncate_text(text: str, max_len: int) str
    }
    
    class ExcelExporter {
        +str output_path
        +dict data
        +Workbook workbook
        +export() str
        +create_summary_sheet() void
        +apply_formatting() void
        +add_hyperlinks() void
        -_create_worksheet(name, data) void
        -_apply_freeze_panes(sheet) void
        -_apply_auto_filter(sheet) void
    }
    
    class DependencyGraph {
        +dict nodes
        +dict edges
        +add_node(id, type, props) void
        +add_edge(source, target, type) void
        +find_circular_paths() list
        +calculate_bfs_levels(start) dict
        +get_downstream(node_id) list
        +get_upstream(node_id) list
    }
    
    UltimateEnterpriseADFAnalyzer --> Logger : uses
    UltimateEnterpriseADFAnalyzer --> Config : uses
    UltimateEnterpriseADFAnalyzer --> ResourceParser : uses
    UltimateEnterpriseADFAnalyzer --> SQLParser : uses
    UltimateEnterpriseADFAnalyzer --> TextSanitizer : uses
    UltimateEnterpriseADFAnalyzer --> ExcelExporter : creates
    UltimateEnterpriseADFAnalyzer --> DependencyGraph : builds
    
    ResourceParser <|-- PipelineParser : inherits
    ResourceParser <|-- DatasetParser : inherits
    
    PipelineParser --> SQLParser : uses
    ExcelExporter --> TextSanitizer : uses
```

