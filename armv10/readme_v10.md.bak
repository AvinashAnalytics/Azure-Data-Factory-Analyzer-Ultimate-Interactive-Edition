        O3["🔴 LS_2<br/><small>Orphaned LinkedService<br/>Reason: Not referenced by any dataset</small>"]
    end
    
    C -.orphaned.-> O1
    E -.orphaned.-> O2
    G -.orphaned.-> O3
    
    classDef usedStyle fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef orphanedStyle fill:#ffebee,stroke:#c62828,stroke-width:2px
    
    class A,B,D,F usedStyle
    class C,E,G,O1,O2,O3 orphanedStyle
```

