### **Complete Config Reference**

<details open>
<summary><b>📋 Click to view full Config class</b></summary>

```python
# ═══════════════════════════════════════════════════════════════════
# CONFIG CLASS - COMPLETE REFERENCE
# ═══════════════════════════════════════════════════════════════════

class Config:
    """
    Centralized configuration for ADF Analyzer v10.0
    All settings are documented and customizable
    """
    
    # ═══════════════════════════════════════════════════════════════
    # 📊 EXCEL LIMITS
    # ═══════════════════════════════════════════════════════════════
    
    # Excel hard limits (Microsoft Office)
    EXCEL_MAX_ROWS = 1048576              # Excel row limit
    SHEET_SPLIT_THRESHOLD = 500000        # Auto-split large sheets
    MAX_EXCEL_CELL_LENGTH = 32767         # Cell character limit
    MAX_SHEET_NAME_LENGTH = 31            # Sheet name limit
    
    # Column sizing
    MAX_COLUMN_WIDTH = 60                 # Maximum column width
    MIN_COLUMN_WIDTH = 10                 # Minimum column width
    
    # ═══════════════════════════════════════════════════════════════
    # 🔍 PARSING LIMITS
    # ═══════════════════════════════════════════════════════════════
    
    MAX_SQL_LENGTH = 10000                # SQL text truncation (chars)
    MAX_ACTIVITY_DEPTH = 20               # Max nesting depth
    MAX_DEPENDENCY_DEPTH = 10             # Max dependency chain
    
    # ═══════════════════════════════════════════════════════════════
    # ⚡ PERFORMANCE TUNING
    # ═══════════════════════════════════════════════════════════════
    
    CIRCULAR_DEPENDENCY_MAX_CYCLES = 100  # Stop after N cycles found
    IMPACT_ANALYSIS_MAX_DEPTH = 5         # BFS depth limit
    BATCH_SIZE = 1000                     # Batch processing size
    
    # ═══════════════════════════════════════════════════════════════
    # 📈 COMPLEXITY THRESHOLDS
    # ═══════════════════════════════════════════════════════════════
    
    COMPLEXITY_CRITICAL_THRESHOLD = 100   # Score >= 100 is CRITICAL
    COMPLEXITY_HIGH_THRESHOLD = 50        # Score >= 50 is HIGH
    COMPLEXITY_MEDIUM_THRESHOLD = 20      # Score >= 20 is MEDIUM
    # Below MEDIUM_THRESHOLD is LOW
    
    # ═══════════════════════════════════════════════════════════════
    # 🔒 SUPPORTED ARM SCHEMAS
    # ═══════════════════════════════════════════════════════════════
    
    SUPPORTED_SCHEMAS = [
        "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
        "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
        "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
        "https://schema.management.azure.com/schemas/2019-08-01/deploymentTemplate.json#",
    ]
    
    # ═══════════════════════════════════════════════════════════════
    # 📝 LOGGING LEVELS
    # ═══════════════════════════════════════════════════════════════
    
    LOG_LEVEL_ERROR = 0     # Only errors
    LOG_LEVEL_WARNING = 1   # Errors + warnings
    LOG_LEVEL_INFO = 2      # Errors + warnings + info (default)
    LOG_LEVEL_DEBUG = 3     # All messages including debug
```

</details>

### **Configuration Customization Examples**

```python
# ═══════════════════════════════════════════════════════════════════
# OPTION 1: Permanent Modification (Edit source file)
# ═══════════════════════════════════════════════════════════════════

# Open adf_analyzer_v10_complete.py
# Find the Config class and modify values:

class Config:
    MAX_SQL_LENGTH = 20000  # Increased from 10000
    MAX_ACTIVITY_DEPTH = 30  # Increased from 20
    COMPLEXITY_CRITICAL_THRESHOLD = 150  # Adjusted for org

# ═══════════════════════════════════════════════════════════════════
# OPTION 2: Runtime Override (Temporary, per-run)
# ═══════════════════════════════════════════════════════════════════

from adf_analyzer_v10_complete import UltimateEnterpriseADFAnalyzer, Config

# Override before creating analyzer
Config.MAX_SQL_LENGTH = 20000
Config.IMPACT_ANALYSIS_MAX_DEPTH = 10
Config.COMPLEXITY_CRITICAL_THRESHOLD = 150

# Create analyzer with modified config
analyzer = UltimateEnterpriseADFAnalyzer('template.json')
analyzer.run()

# ═══════════════════════════════════════════════════════════════════
# OPTION 3: Environment-Specific (Advanced)
# ═══════════════════════════════════════════════════════════════════

import os
from adf_analyzer_v10_complete import Config

# Load from environment variables
Config.MAX_SQL_LENGTH = int(os.getenv('ADF_MAX_SQL_LENGTH', 10000))
Config.IMPACT_ANALYSIS_MAX_DEPTH = int(os.getenv('ADF_IMPACT_DEPTH', 5))
Config.LOG_LEVEL = int(os.getenv('ADF_LOG_LEVEL', Config.LOG_LEVEL_INFO))

# Use in Docker or CI/CD:
# docker run -e ADF_MAX_SQL_LENGTH=20000 -e ADF_LOG_LEVEL=3 ...
```

