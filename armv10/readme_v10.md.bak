## **4.5 VERIFICATION & TESTING**

### **Automated Verification Script**

<details open>
<summary><b>🧪 Click to view complete verification script</b></summary>

```python
#!/usr/bin/env python3
"""
═══════════════════════════════════════════════════════════════════
ADF Analyzer v10.0 - Installation Verification Script
═══════════════════════════════════════════════════════════════════
Run this script to verify your installation is working correctly.

Usage:
    python test_installation.py
"""

import sys
import importlib
from pathlib import Path

def print_section(title):
    """Print formatted section header"""
    print(f"\n{'═'*70}")
    print(f"  {title}")
    print(f"{'═'*70}\n")

def test_python_version():
    """Test Python version compatibility"""
    print_section("1️⃣ Python Version Check")
    
    version = sys.version_info
    version_str = f"{version.major}.{version.minor}.{version.micro}"
    
    print(f"Python version: {version_str}")
    
    if version.major == 3 and version.minor >= 7:
        print(f"✅ Python {version_str} is compatible (3.7+ required)")
        if version.minor >= 9:
            print("🌟 Recommended version detected!")
        return True
    else:
        print(f"❌ Python 3.7+ required, found {version_str}")
        return False

def test_packages():
    """Test required package installation"""
    print_section("2️⃣ Package Installation Check")
    
    required = {
        'pandas': '1.3.0',
        'openpyxl': '3.0.0',
    }
    
    optional = {
        'tqdm': '4.60.0',
        'streamlit': '1.28.0',
        'plotly': '5.0.0',
    }
    
    all_required_ok = True
    
    # Test required packages
    print("Required packages:")
    for package, min_version in required.items():
        try:
            mod = importlib.import_module(package)
            version = getattr(mod, '__version__', 'unknown')
            print(f"  ✅ {package:15} v{version:15} (need >= {min_version})")
        except ImportError:
            print(f"  ❌ {package:15} NOT INSTALLED (required)")
            all_required_ok = False
    
    # Test optional packages
    print("\nOptional packages:")
    for package, min_version in optional.items():
        try:
            mod = importlib.import_module(package)
            version = getattr(mod, '__version__', 'unknown')
            print(f"  ✅ {package:15} v{version:15}")
        except ImportError:
            print(f"  ⚠️  {package:15} NOT INSTALLED (optional)")
    
    return all_required_ok

def test_analyzer_files():
    """Test analyzer files exist"""
    print_section("3️⃣ Analyzer Files Check")
    
    files = [
        ('adf_analyzer_v10_complete.py', True, 'Main analyzer'),
        ('adf_analyzer_v10_patch.py', False, 'Enhancement patches'),
        ('adf_analyzer_v10_excel_enhancements.py', False, 'Excel formatting'),
    ]
    
    all_required_ok = True
    
    for filename, required, description in files:
        filepath = Path(filename)
        if filepath.exists():
            size_kb = filepath.stat().st_size / 1024
            print(f"  ✅ {filename:40} ({size_kb:,.0f} KB)")
            print(f"      {description}")
        else:
            if required:
                print(f"  ❌ {filename:40} MISSING (required)")
                print(f"      {description}")
                all_required_ok = False
            else:
                print(f"  ⚠️  {filename:40} MISSING (optional)")
                print(f"      {description}")
    
    return all_required_ok

def test_analyzer_import():
    """Test importing the analyzer"""
    print_section("4️⃣ Analyzer Import Test")
    
    try:
        from adf_analyzer_v10_complete import (
            UltimateEnterpriseADFAnalyzer,
            Config
        )
        print("  ✅ Successfully imported UltimateEnterpriseADFAnalyzer")
        
        # Count config settings
        config_attrs = [a for a in dir(Config) if not a.startswith('_')]
        print(f"  ✅ Config class loaded ({len(config_attrs)} settings)")
        
        # Test instantiation
        try:
            analyzer = UltimateEnterpriseADFAnalyzer('dummy.json')
            print("  ✅ Analyzer instance created successfully")
        except Exception as e:
            print(f"  ⚠️  Analyzer instantiation: {e}")
        
        return True
    except Exception as e:
        print(f"  ❌ Failed to import analyzer: {e}")
        return False

def test_help_command():
    """Test help command"""
    print_section("5️⃣ Help Command Test")
    
    try:
        import subprocess
        result = subprocess.run(
            [sys.executable, 'adf_analyzer_v10_complete.py', '--help'],
            capture_output=True,
            text=True,
            timeout=10
        )
        
        if 'USAGE:' in result.stdout or 'usage:' in result.stdout.lower():
            print("  ✅ Help command works correctly")
            return True
        else:
            print(f"  ⚠️  Help command returned code {result.returncode}")
            return True  # Still OK
    except FileNotFoundError:
        print("  ⚠️  Could not run command (file not in current directory)")
        return True  # Not a fatal error
    except Exception as e:
        print(f"  ❌ Help command failed: {e}")
        return False

def print_summary(results):
    """Print verification summary"""
    print_section("📊 VERIFICATION SUMMARY")
    
    total = len(results)
    passed = sum(results.values())
    
    print(f"Tests passed: {passed}/{total}\n")
    
    for test_name, result in results.items():
        status = "✅ PASS" if result else "❌ FAIL"
        print(f"  {status} : {test_name}")
    
    print()
    
    if passed == total:
        print("╔══════════════════════════════════════════════════════════════╗")
        print("║  🎉 ALL VERIFICATION TESTS PASSED!                          ║")
        print("║  ✅ Your installation is ready to use                       ║")
        print("╚══════════════════════════════════════════════════════════════╝\n")
        
        print("Next steps:")
        print("  1. Run your first analysis:")
        print("     python adf_analyzer_v10_complete.py your_template.json")
        print("  2. Review the Excel output:")
        print("     output/adf_analysis_latest.xlsx\n")
        return True
    else:
        print("╔══════════════════════════════════════════════════════════════╗")
        print("║  ⚠️  SOME TESTS FAILED                                      ║")
        print("║  Please fix the issues above                                ║")
        print("╚══════════════════════════════════════════════════════════════╝\n")
        
        print("📘 For help, refer to:")
        print("  • Part 4.2: Installation Guide")
        print("  • Part 9: Troubleshooting & FAQ\n")
        return False

def main():
    """Main verification routine"""
    print("""
╔══════════════════════════════════════════════════════════════════╗
║                                                                  ║
║         🧪 ADF ANALYZER v10.0 - INSTALLATION VERIFICATION        ║
║                                                                  ║
╚══════════════════════════════════════════════════════════════════╝
    """)
    
    # Run all tests
    results = {
        'Python Version': test_python_version(),
        'Required Packages': test_packages(),
        'Analyzer Files': test_analyzer_files(),
        'Analyzer Import': test_analyzer_import(),
        'Help Command': test_help_command(),
    }
    
    # Print summary and exit
    success = print_summary(results)
    sys.exit(0 if success else 1)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n⚠️  Verification interrupted by user")
        sys.exit(130)
    except Exception as e:
        print(f"\n❌ Unexpected error: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)
```

</details>

**Save as:** `test_installation.py` and run:

```bash
python test_installation.py
```

