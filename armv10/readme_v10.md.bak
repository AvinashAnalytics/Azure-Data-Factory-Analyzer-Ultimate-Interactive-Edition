# ✅ adf_analyzer_v10_patch.py (optional, ~500 lines)
# ✅ your_factory_template.json (your ARM template)

# Verify files exist
dir *.py

# ┌─────────────────────────────────────────────────────────────────┐
# │ STEP 8: Test Installation (1 minute)                           │
