    LEVEL1 --> CALC["📐 Calculate<br/>Blast Radius"]
    LEVEL2 --> CALC
    LEVEL3 --> CALC
    LEVEL4 --> CALC
    LEVEL5 --> CALC
    
    CALC --> BLAST["💥 Blast Radius =<br/><small>upstream_count +</small><br/><small>downstream_count +</small><br/><small>datasets_count +</small><br/><small>dataflows_count</small>"]
    
    BLAST --> STORE["💾 Store Impact Record"]
    
