{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {},
  "variables": {},
  "resources": [
    {
      "type": "Microsoft.DataFactory/factories",
      "apiVersion": "2018-06-01",
      "name": "test-adf-factory",
      "location": "East US",
      "properties": {
        "globalConfigurations": {},
        "dataFactorySchema": {
          "version": "2018-06-01"
        }
      },
      "resources": [
        {
          "type": "pipelines",
          "apiVersion": "2018-06-01", 
          "name": "test-pipeline",
          "dependsOn": ["[resourceId('Microsoft.DataFactory/factories', 'test-adf-factory')]"],
          "properties": {
            "activities": [
              {
                "name": "Copy Data Activity",
                "type": "Copy",
                "typeProperties": {
                  "source": {
                    "type": "BlobSource"
                  },
                  "sink": {
                    "type": "SqlSink"
                  }
                }
              }
            ]
          }
        },
        {
          "type": "datasets",
          "apiVersion": "2018-06-01",
          "name": "test-dataset",
          "dependsOn": ["[resourceId('Microsoft.DataFactory/factories', 'test-adf-factory')]"],
          "properties": {
            "type": "AzureBlob",
            "linkedServiceName": {
              "referenceName": "test-linked-service",
              "type": "LinkedServiceReference"
            }
          }
        },
        {
          "type": "linkedServices",
          "apiVersion": "2018-06-01",
          "name": "test-linked-service", 
          "dependsOn": ["[resourceId('Microsoft.DataFactory/factories', 'test-adf-factory')]"],
          "properties": {
            "type": "AzureBlobStorage",
            "typeProperties": {
              "connectionString": "DefaultEndpointsProtocol=https;AccountName=test;AccountKey=test;"
            }
          }
        }
      ]
    }
  ]
}